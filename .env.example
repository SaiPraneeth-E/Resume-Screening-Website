# Database Configuration (PostgreSQL in production, SQLite default for zero-setup local dev)
DATABASE_URL=sqlite+aiosqlite:///./sql_app.db

# AI Provider Configuration ("openai", "gemini", "anthropic", or "local")
AI_PROVIDER=local
AI_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Application Settings
MAX_FILE_SIZE_MB=10
MAX_RESUMES_PER_BATCH=20
